# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — AWS Typing Challenge (Vite + React)
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite/
vite.config.*.timestamp-*

# ── Environment variables & secrets ──────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Package manager lock files (keep only one) ───────────────────────────────
# Uncomment the lock file you are NOT using to exclude it:
# yarn.lock
# pnpm-lock.yaml

# ── Misc ──────────────────────────────────────────────────────────────────────
*.local
.cache/
.temp/
.tmp/
